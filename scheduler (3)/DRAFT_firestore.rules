rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helpers
    function isValidPlan(data) {
      let allowedFields = [
        'id', 'title', 'date', 'startHour', 'startMinute', 'duration', 'color', 'notes', 'tags',
        'reminderMinutes', 'applyMode', 'applyDays', 'applyWeekInterval', 'applyWeekDays', 'applyUntil',
        'createdAt', 'updatedAt', 'deviceId', 'syncStatus', 'version', 'isSynced', 'deletedAt'
      ];

      return data.keys().hasAll(['id', 'title', 'date', 'startHour', 'duration', 'color'])
        && data.keys().hasOnly(allowedFields)
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 500
        && data.date is string && data.date.size() <= 100
        && data.startHour is number
        && data.duration is number
        && (!('color' in data) || (data.color is string && data.color.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
        && (!('startMinute' in data) || (data.startMinute is number))
        && (!('duration' in data) || (data.duration is number))
        && (!('reminderMinutes' in data) || (data.reminderMinutes is number))
        && (!('applyWeekInterval' in data) || (data.applyWeekInterval is number))
        && (!('version' in data) || (data.version is number))
        && (!('isSynced' in data) || (data.isSynced is bool));
    }

    // --- Rules ---

    match /users/{userId} {
      // Allow user document itself
      allow read, write: if isOwner(userId);

      match /plans/{planId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(planId);
        
        allow create: if isOwner(userId) 
          && isValidId(planId)
          && isValidPlan(incoming());

        allow update: if isOwner(userId)
          && isValidPlan(incoming());

        allow delete: if isOwner(userId);
      }

      match /meta/weekMetas {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /meta/settings {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    match /sharedSchedules/{shareId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerUid', 'startWeek', 'endWeek', 'plans', 'startHour', 'endHour', 'language', 'createdAt', 'expiresAt'])
        && request.resource.data.expiresAt > request.time;
      allow get: if request.time < resource.data.expiresAt;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow list, update: if false;
    }
  }
}
