rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helpers
    function isValidPlan(data) {
      return data.keys().hasAll(['id', 'title', 'date']) 
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 500
        && data.date is string && data.date.size() <= 100
        && (!('color' in data) || (data.color is string && data.color.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
        && (!('completed' in data) || (data.completed is bool))
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 10))
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 10));
    }

    // --- Rules ---

    match /users/{userId} {
      // Allow user document itself
      allow read, write: if isOwner(userId);

      match /plans/{planId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(planId);
        
        allow create: if isOwner(userId) 
          && isValidId(planId)
          && isValidPlan(incoming());

        allow update: if isOwner(userId)
          && isValidPlan(incoming());

        allow delete: if isOwner(userId);
      }

      match /meta/weekMetas {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /meta/settings {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }
  }
}
